# Never place real Alpaca credentials in this file.
ALPACA_PAPER_TRADE=true
ALPACA_MCP_COMMAND=uvx
ALPACA_MCP_ARGS=alpaca-mcp-server
IPULSE_AGENT_EXECUTION_ENABLED=false

# Optional structured-output research advisors. Never commit a real key.
OPENAI_API_KEY=
IPULSE_OPENAI_MODEL=gpt-5.4-mini

# Optional normalized, versioned evidence document. Never point this at secrets.
IPULSE_RESEARCH_EVIDENCE_FILE=

# Optional read-only iPulse ETF fundamentals adapter.
IPULSE_ENABLE_BIGQUERY_EVIDENCE=false
IPULSE_BQ_PROJECT_ID=
IPULSE_BQ_FUNDAMENTAL_DATASET=
